# Copy to .env.local and fill in real values. Never commit .env.local.
# In InsForge deployment settings, set the NEXT_PUBLIC_* keys.
# Placeholders only — every value below is empty or an example.

# Canonical public origin — used for SEO canonical/OG tags and public metadata.
# Production: https://pradipuponnash.com
# Local dev:  http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://pradipuponnash.com

# Server-side public origin — used for NagorikPay redirect/webhook URLs and
# guest email exchange links. Production must be the custom domain.
# Local dev:  http://localhost:3000
APP_URL=https://pradipuponnash.com

# InsForge backend (project: website)
NEXT_PUBLIC_INSFORGE_URL=https://cpd9mnqf.ap-southeast.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# InsForge deploy scripts only (scripts/deploy-*.mjs, scripts/check-rpcs.mjs).
# Not used by the app at runtime. Owner-run; never commit real values.
INSFORGE_API_KEY=
INSFORGE_DEPLOY_UPLOAD_CONCURRENCY=

# Server-only. REQUIRED at runtime: payment settlement, the download
# self-heal and the contact-form rate limit use it. Never expose to the browser.
INSFORGE_SERVICE_KEY=

# Payment gateway (NagorikPay)
# API-KEY header → live key from Brands panel.
# NAGORIKPAY_WEBHOOK_SECRET: REQUIRED. Generate in NagorikPay panel → Brands → Webhook Secret.
# The webhook route verifies with this secret and falls back to the API key only while
# the secret is unset. Remove the fallback once a sandbox payment confirms the secret.
# NAGORIKPAY_BASE_URL live = https://secure-pay.nagorikpay.com/api/payment
# Sandbox keys (sk_test_…) are only valid on https://sandbox-api.nagorikpay.com/ (UNVERIFIED exact sandbox path)
NAGORIKPAY_API_KEY=
NAGORIKPAY_BASE_URL=https://secure-pay.nagorikpay.com/api/payment
NAGORIKPAY_WEBHOOK_SECRET=

# Contact-form mail (app/api/contact/route.ts, server-only)
# The current application sends guest download emails through Gmail SMTP.
# Resend is not required unless the email implementation is migrated.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Private random salt for guest checkout rate limiting. Generate with:
#   openssl rand -hex 32
# Do not use another credential as this value.
GUEST_RATE_LIMIT_SALT=

# Owner-supplied contact/marketing (leave empty until the owner provides them)
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_GA_ID=