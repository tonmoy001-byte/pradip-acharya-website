# Copy to .env.local and fill in real values. Never commit .env.local.
# In InsForge deployment settings, set the NEXT_PUBLIC_* keys.
# Placeholders only — every value below is empty or an example.

# Canonical public origin — the ONLY change needed when moving to a custom domain.
NEXT_PUBLIC_SITE_URL=https://pradipbooks.insforge.site

# InsForge backend (project: website)
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# InsForge deploy scripts only (scripts/deploy-*.mjs, scripts/check-rpcs.mjs).
# Not used by the app at runtime. Owner-run; never commit real values.
INSFORGE_API_KEY=
INSFORGE_SERVICE_KEY=
INSFORGE_DEPLOY_UPLOAD_CONCURRENCY=

# Payment gateway (NagorikPay)
# API-KEY header → live key from Brands panel.
# NAGORIKPAY_WEBHOOK_SECRET: generate in NagorikPay panel → Brands → Webhook Secret;
# if empty the API key signs webhooks.
# NAGORIKPAY_BASE_URL live = https://secure-pay.nagorikpay.com/api/payment
# Sandbox keys (sk_test_…) are only valid on https://sandbox-api.nagorikpay.com/ (UNVERIFIED exact sandbox path)
NAGORIKPAY_API_KEY=
NAGORIKPAY_BASE_URL=https://secure-pay.nagorikpay.com/api/payment
NAGORIKPAY_WEBHOOK_SECRET=

# Contact-form mail (app/api/contact/route.ts, server-only)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Owner-supplied contact/marketing (leave empty until the owner provides them)
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_GA_ID=
